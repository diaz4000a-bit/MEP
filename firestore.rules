rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function auth0()    { return request.auth != null; }
    function yo()       { return request.auth.uid; }
    function datos()    { return get(/databases/$(database)/documents/usuarios/$(yo())).data; }
    function rol()      { return datos().rol; }
    function activo()   { return auth0() && datos().activo == true; }
    function esAdmin()  { return activo() && rol() == 'admin'; }
    function esGestor() { return activo() && rol() in ['admin', 'coordinador']; }

    match /usuarios/{uid} {
      allow read:   if activo();
      allow create: if auth0() && yo() == uid
                    && request.resource.data.rol == 'usuario'    // nadie se autoasciende
                    && request.resource.data.activo == false;    // un admin lo activa
      allow update: if esAdmin()
                    || (activo() && yo() == uid
                        && request.resource.data.rol == resource.data.rol
                        && request.resource.data.activo == resource.data.activo);
      allow delete: if esAdmin();
    }

    match /proyectos/{pid} {
      allow read:           if activo();
      allow create, delete: if esGestor();
      allow update:         if esGestor();

      match /tareas/{tid} {
        allow read:           if activo();
        allow create, delete: if esGestor();
        // ← esto es lo que la v1 NO podía expresar:
        allow update: if esGestor()
                      || (activo() && resource.data.responsableUid == yo());
      }
    }

    match /jornadas/{jid} {
      // `list` separado de `get`: Firestore no puede probar que una query cumple una regla
      // con OR + get() ajeno al resource, así que la consulta en vivo del cliente (¿tengo
      // una jornada abierta?) solo puede pedir las suyas. Los reportes de equipo (gestor
      // viendo jornadas ajenas) se sirven desde el servidor con el Admin SDK, que no pasa
      // por reglas.
      allow get:    if activo() && (resource.data.uid == yo() || esGestor());
      allow list:   if activo() && request.auth.uid == resource.data.uid;
      allow create: if activo() && request.resource.data.uid == yo();
      allow update: if activo() && (resource.data.uid == yo() || esGestor());
      allow delete: if esAdmin();
    }

    match /config/{doc} {
      allow read:  if activo();
      allow write: if esGestor();
    }
  }
}
