# Config publica del proyecto de Firebase (visible en el bundle del navegador,
# ver src/lib/firebase/client.ts). Se obtiene en Firebase Console > Configuracion
# del proyecto > Tus apps > SDK setup and configuration.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Cuenta de servicio del Admin SDK (server-only, ver src/lib/firebase/admin.ts).
# Genera el JSON en Firebase Console > Configuracion del proyecto > Cuentas de servicio
# > Generar nueva clave privada, y codifica el archivo completo en base64:
#   Linux/macOS: base64 -i service-account.json | tr -d '\n'
#   Windows PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
# NUNCA subas el JSON ni este valor decodificado al repo.
FIREBASE_SERVICE_ACCOUNT_B64=

# --- Informe diario por WhatsApp --------------------------------------------
# Destinatarios de los botones "Enviar por WhatsApp" del diálogo de informe.
# OPCIONAL: sin esta variable se usan los dos números de fábrica que hay en
# `DESTINOS_POR_DEFECTO` (src/lib/whatsapp.ts). Definirla los reemplaza por completo,
# que es lo que permite cambiar de destinatario sin desplegar.
# Se admite cualquier formato legible (se normaliza a E.164) y coma, punto y coma
# o salto de línea como separador.
INFORME_WHATSAPP_DESTINOS=+57 320 4537010, +57 310 8043958
